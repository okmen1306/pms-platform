{
  "name": "@pms/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Tüm mikroservisler ve frontend arasında paylaşılan DTO, event ve hata sözleşmeleri. Sadece bu paket üzerinden servisler arası kontrat değişir.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist-esm/index.browser.js",
      "import": "./dist-esm/index.js",
      "require": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist-esm/*.js",
      "require": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.esm.json"
  },
  "dependencies": {
    "zod": "^3.23.8",
    "amqplib": "^0.10.4",
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "@types/amqplib": "^0.10.5"
  }
}
